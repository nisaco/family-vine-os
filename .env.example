# Family Vine Choir - Environment Variables
# Copy this file to .env.local for local development.

# MongoDB connection string. Store the real value in a secret/environment variable.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/family_vine?retryWrites=true&w=majority
MONGODB_DB=family_vine

# Optional path to an existing SQLite database when running the one-time migration script.
SQLITE_PATH=./data/family_vine.db

# Authentication secret (used for HMAC signing session tokens if needed, min 32 characters)
AUTH_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Port configuration (default 3000)
PORT=3000

# Node environment
NODE_ENV=development
